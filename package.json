{
  "name": "aikah",
  "version": "1.0.0",
  "private": true,
  "description": "Aikah — a self-sufficient cosmic material. Cinematic sci-fi landing page.",
  "scripts": {
    "dev": "concurrently -k -n css,serve -c magenta,cyan \"npm:watch:css\" \"npm:serve\"",
    "serve": "node serve.mjs 12000",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/aikah.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/aikah.css --minify",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%"
  ]
}
